# Copy to Railway Variables (or a local .env that is gitignored).
# Do NOT put a real secret in git. After rotating the exposed key,
# set the NEW secret in Railway only.

STRIPE_SECRET_KEY=

# Public site origin — used for success/cancel redirects and CORS
SITE_URL=https://saveburyyouth.com

# Optional extra CORS origins, comma-separated (local preview, www, etc.)
ALLOWED_ORIGINS=

# Railway sets PORT automatically. For local: PORT=3000
PORT=

# Votes (Railway Variables only — never commit real values)
SUPABASE_URL=https://rfnxiaaewhhtjpwwxibd.supabase.co
# Service-role key (server only; never put this in js/config.js)
SUPABASE_SERVICE_ROLE_KEY=
